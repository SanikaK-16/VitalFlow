# VitalFlow Emergency Operations Platform - Environment Configuration Example
# Copy this file to .env for local overrides

# Application
PROJECT_NAME="VitalFlow Emergency Operations Platform"
VERSION="3.0.0"

# Security & JWT (Replace with a strong random secret key in production)
SECRET_KEY="vitalflow-replace-with-a-secure-random-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: Local SQLite (automatically created at startup)
DATABASE_URL="sqlite:///./vitalflow.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/vitalflow"

# Event Bus & Redis (Optional - in-memory pub/sub fallback is active by default)
REDIS_URL="redis://localhost:6379/0"
